    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.3",
    "supabase": "^2.121.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "24.x",
