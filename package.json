    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@honeybadger-io/nextjs": "^6.0.4",
    "@honeybadger-io/react": "^6.1.38",
    "@relewise/client": "^2.29.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.6.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
