# Supabase Auth / data
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Honeybadger observability
NEXT_PUBLIC_HONEYBADGER_API_KEY=your-honeybadger-api-key
NEXT_PUBLIC_HONEYBADGER_ASSETS_URL=https://assets.honeybadger.io
NEXT_PUBLIC_HONEYBADGER_REVISION=local

# Open Source AI runtime endpoints (server-side only)
OLLAMA_BASE_URL=
VLLM_BASE_URL=
BENTOML_BASE_URL=

# Hosted/open model provider
HUGGINGFACE_API_KEY=

# Optional bearer token for OpenAI-compatible self-hosted gateways
OPEN_SOURCE_AI_API_KEY=

# DataCamp catalog integration (server-side only)
DATACAMP_API_KEY=
DATACAMP_CATALOG_API_BASE_URL=https://lms-catalog-api.datacamp.com

# Vector infrastructure
WEAVIATE_URL=
WEAVIATE_API_KEY=
MILVUS_URI=
MILVUS_TOKEN=

# Todoist OAuth (server-side only)
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TODOIST_REDIRECT_URI=

# Microsoft Graph / SharePoint (server-side only; supplied by OAuth runtime)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_GRAPH_ACCESS_TOKEN=

# Notion OAuth (server-side only)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# Asana OAuth (server-side only)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=

# Trello OAuth 2.0 (server-side only)
TRELLO_CLIENT_ID=
TRELLO_CLIENT_SECRET=
TRELLO_REDIRECT_URI=

# Airtable — server-side operations/content management
# Never expose the personal access token through NEXT_PUBLIC_* variables.
AIRTABLE_PERSONAL_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# Outlook Calendar / Microsoft Entra OAuth (server-side only)
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_REDIRECT_URI=
OUTLOOK_CALENDAR_SESSION_SECRET=

# Relewise Search (server-side only)
RELEWISE_DATASET_ID=
RELEWISE_API_KEY=
RELEWISE_SERVER_URL=https://api.relewise.com

# Parallel Search / Extract (server-side only)
# Never expose this key through NEXT_PUBLIC_* variables.
PARALLEL_API_KEY=
# Optional override for tests or controlled server environments.
PARALLEL_API_BASE_URL=https://api.parallel.ai
